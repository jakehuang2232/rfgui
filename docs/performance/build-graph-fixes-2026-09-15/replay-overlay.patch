+#[test]
+#[ignore = "isolated diagnostic replay"]
+fn native_build_graph_diagnosis() -> Result<(), String> {
+    let _cleanup = TextCacheCleanup;
+    let mode = std::env::var("DIAG_MODE").unwrap_or_else(|_| "artifact".into());
+    let dpr: u32 = std::env::var("DIAG_DPR").unwrap_or_else(|_| "2".into()).parse().unwrap();
+    let (device, queue) = pollster::block_on(async {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor { flags: wgpu::InstanceFlags::empty(), ..wgpu::InstanceDescriptor::new_without_display_handle() });
+        let adapter = instance.request_adapter(&wgpu::RequestAdapterOptions::default()).await.map_err(|e|e.to_string())?;
+        eprintln!("diag-adapter {:?}", adapter.get_info());
+        adapter.request_device(&wgpu::DeviceDescriptor::default()).await.map_err(|e|e.to_string())
+    })?;
+    let pixel_gpu = gpu::Gpu { device: device.clone(), queue: queue.clone() };
+    let mut viewport = Viewport::new();
+    viewport.set_paint_renderer_mode(if mode == "legacy" { ViewportPaintRendererMode::Legacy } else { ViewportPaintRendererMode::RetainedAuto });
+    let mut root = rfgui::ui::rsx_scope(|| rsx! { <MainScene /> });
+    let now = Instant::now();
+    let mut previous_keys=std::collections::HashSet::new();
+    for frame in 0..150u64 {
+        let phase = if frame < 40 { "warm" } else if frame < 60 { "idle" } else if frame < 80 { "hover" } else if frame < 90 { "press" } else { "drag" };
+        let clock_before = viewport.diagnosis_probe();
+        let event_start = Instant::now();
+        if (60..80).contains(&frame) {
+            viewport.set_pointer_position_viewport(10.0, 10.0);
+            viewport.dispatch_pointer_move_event();
+        }
+        if frame == 80 {
+            viewport.set_pointer_position_viewport(120.0, 62.0);
+            viewport.dispatch_pointer_move_event();
+            viewport.set_pointer_button_pressed(PointerButton::Left, true);
+            assert!(viewport.dispatch_pointer_down_event(PointerButton::Left));
+        }
+        let step = if frame >= 90 { let n=(frame-90)%40; if n < 20 {n+1} else {39-n} } else {0};
+        if frame >= 90 {
+            viewport.set_pointer_position_viewport(120.0 + step as f32 * 2.0, 62.0 + step as f32);
+            viewport.dispatch_pointer_move_event();
+        }
+        let event_ms = event_start.elapsed().as_secs_f64()*1000.0;
+        let event_mutations = viewport.diagnosis_probe()-clock_before;
+        let build_start = Instant::now();
+        let rsx_ms = if rfgui::ui::peek_state_dirty().needs_rebuild() { root = rfgui::ui::rsx_scope(|| rsx! { <MainScene /> }); build_start.elapsed().as_secs_f64()*1000.0 } else { 0.0 };
+        let result = viewport.render_rsx_offscreen_for_test(&root, device.clone(), queue.clone(), [1280*dpr,800*dpr], dpr as f32, now + std::time::Duration::from_millis(frame*16))?;
+        let keys=viewport.node_arena().iter().map(|(k,_)|k).collect::<std::collections::HashSet<_>>();
+        let new_keys=keys.difference(&previous_keys).count();
+        if std::env::var_os("DIAG_MUTATION_TRACE").is_some() && (90..93).contains(&frame) {
+            for key in keys.difference(&previous_keys) {
+                let node=viewport.node_arena().get(*key).unwrap();
+                let mut ancestry=Vec::new();let mut parent=node.parent();
+                while let Some(k)=parent {let n=viewport.node_arena().get(k).unwrap();ancestry.push((n.element.element_type_name(),n.element.stable_id()));parent=n.parent();}
+                eprintln!("diag-new-node frame={frame} key={key:?} type={} stable={} bounds={:?} ancestry={ancestry:?}",node.element.element_type_name(),node.element.stable_id(),node.element.box_model_snapshot());
+            }
+        }
+        previous_keys=keys;
+        if std::env::var_os("DIAG_MUTATION_TRACE").is_some() && frame==91 {
+            for (key,node) in viewport.node_arena().iter().filter(|(k,_)| ["NodeKey(1892v1)","NodeKey(1896v1)","NodeKey(752v1)"].contains(&format!("{k:?}").as_str())) {
+                let mut ancestry=Vec::new();let mut parent=node.parent();
+                while let Some(k)=parent {let n=viewport.node_arena().get(k).unwrap();ancestry.push((k,n.element.element_type_name(),n.element.stable_id()));parent=n.parent();}
+                eprintln!("diag-order-node key={key:?} type={} stable={} bounds={:?} ancestry={ancestry:?}",node.element.element_type_name(),node.element.stable_id(),node.element.box_model_snapshot());
+            }
+        }
+        let index=viewport.diagnosis_index().unwrap_or(u64::MAX);
+        let mut boxes=viewport.node_arena().iter().map(|(_,node)| {let b=node.element.box_model_snapshot();(node.element.stable_id(),[b.x.to_bits(),b.y.to_bits(),b.width.to_bits(),b.height.to_bits()])}).collect::<Vec<_>>();
+        boxes.sort_unstable();
+        let mut hash=0xcbf29ce484222325u64;
+        for (_,b) in &boxes {for v in b {hash=(hash ^ *v as u64).wrapping_mul(0x100000001b3);}}
+        if frame>=90 { assert!(boxes.iter().any(|(_,b)| f32::from_bits(b[0]) == 48.0+step as f32*2.0 && f32::from_bits(b[1]) == 48.0+step as f32 && f32::from_bits(b[2]) == 360.0), "Inspector must move frame={frame}"); }
+        println!("diag-frame mode={mode} dpr={dpr} frame={frame} phase={phase} step={step} nodes={} geometry={hash:016x} artifact={} fallback={} index={index} new_keys={new_keys} event_mutations={event_mutations} event_ms={event_ms:.6} rsx_ms={:.6} reuse={} raster={} record_hits={} cpu_ms={:?}",boxes.len(),result.artifact_selected,result.fallback,rsx_ms,result.reuses,result.rerasterizations,result.command_replays,result.cpu_ms);
+        if [59,79,89,109,129,149].contains(&frame) {
+            if let Ok(dir) = std::env::var("DIAG_PIXEL_DIR") {
+                let pixels = pixel_gpu.read(&result.texture, [1280*dpr,800*dpr])?;
+                std::fs::create_dir_all(&dir).map_err(|e|e.to_string())?;
+                std::fs::write(format!("{dir}/{mode}-{frame}.rgba"), pixels).map_err(|e|e.to_string())?;
+            }
+        }
+        device.poll(wgpu::PollType::wait_indefinitely()).map_err(|e|e.to_string())?;
+    }
+    Ok(())
+}
